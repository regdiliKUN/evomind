# 虚拟环境
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 运行时数据（知识库、下载的模型、微调产出，体积大且属于个人数据）
data/
!data/.gitkeep

# 打包产物（可用 scripts/pack.py 重新生成，不入库）
dist/
build/
build_evomind/
# PyInstaller 生成的单文件启动器与其构建配置（由 evomind_launcher.py 重新打包）
EvoMind.exe
EvoMind.spec

# 临时文件
.tmpedge/
*.log
*.png
*.jpg

# 但图标资源要提交
!assets/*.png

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/

# 基准产物（可重新生成的对照 json，体积大）
scripts/bench/*.json
